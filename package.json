{
  "name": "quran-tajweed",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "rules:validate": "tsx scripts/validate-rules.ts",
    "rules:audit": "tsx scripts/audit-corpus.ts",
    "annotate": "tsx scripts/annotate.ts",
    "rules:verify": "tsx scripts/verify-rules.ts",
    "conformance:freeze": "tsx scripts/freeze-conformance.ts",
    "playground:build": "tsx scripts/build-playground.ts",
    "edition:check": "tsx scripts/check-edition.ts",
    "edition:diff": "tsx scripts/compare-editions.ts",
    "inspect": "tsx scripts/inspect.ts",
    "make-edition": "tsx scripts/make-edition.ts",
    "import:quran-text": "tsx scripts/import-quran-text.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
