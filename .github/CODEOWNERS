# The corpus is reviewed differently from the code.
#
# A change to a rule is a claim about how the Quran is recited, and is approved
# by someone qualified in tajweed rather than by whoever has merge rights. Add
# those reviewers here; until then this file records the intent and the
# requirement stated in CONTRIBUTING.md.

/packages/rules/            @quran-ws/tajweed-reviewers
/packages/annotations/      @quran-ws/tajweed-reviewers
/editions/                  @quran-ws/tajweed-reviewers
/docs/coverage.md           @quran-ws/tajweed-reviewers

# Normalisation decides what the text is understood to say before any rule sees
# it, and an edition is the text itself, so both are held to the same bar.
/packages/core/src/normalize.ts   @quran-ws/tajweed-reviewers
